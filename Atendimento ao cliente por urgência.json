        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body;\n// Validação\nif (!b || typeof b !== 'object' || Array.isArray(b)) throw new Error('O corpo deve ser um objeto JSON.');\n// Campos da mensagem\nconst fields = ['nome_cliente', 'email', 'categoria', 'urgencia', 'mensagem'];\n// Validação de campos\nfor (const f of fields) if (typeof b[f] !== 'string' || !b[f].trim()) throw new Error('Campo obrigatório inválido: ' + f);\n// Captura e formatação da urgencia\nconst urgencia = b.urgencia.trim().toUpperCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n// Valida urgência\nif (!['ALTA', 'MEDIA', 'BAIXA'].includes(urgencia)) throw new Error('Urgência deve ser ALTA, MÉDIA ou BAIXA.');\n// Valida urgência\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(b.email.trim())) throw new Error('E-mail inválido.');\n// validação dos campos\nconst esc = s => s.trim().replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n// geração de de um novo json validado\nreturn {json:{nome_cliente:esc(b.nome_cliente),email:esc(b.email),categoria:esc(b.categoria),urgencia,mensagem:esc(b.mensagem)}};"
      },
